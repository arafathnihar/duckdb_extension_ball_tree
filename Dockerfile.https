# syntax=docker/dockerfile:1
#
# Like the Dockerfile, but httpfs is built into the binary so https:// (and s3://) files can be read. The binary is
# dynamic, so the runtime image needs glibc, TLS certificates and tzdata: distroless "base" has them.
#
#   docker build -f Dockerfile.https -t duckdb-ball-tree:https .
#   docker run --rm -v "$PWD":/data duckdb-ball-tree:https /data/my.duckdb -c "SELECT ..."

FROM debian:bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
        make g++ cmake ninja-build python3 git ca-certificates curl zip unzip tar pkg-config \
    && rm -rf /var/lib/apt/lists/*

# httpfs needs OpenSSL and libcurl; vcpkg builds them as static libraries. The clone must not be shallow: DuckDB's
# dependency manifest pins a vcpkg baseline commit, which vcpkg has to look up in the git history.
RUN git clone --branch 2026.07.29 https://github.com/microsoft/vcpkg.git /opt/vcpkg \
    && /opt/vcpkg/bootstrap-vcpkg.sh -disableMetrics

WORKDIR /src
COPY . .

# Built on Debian 12, so the binary only needs glibc 2.36. libstdc++ and libgcc are linked statically (the runtime
# image has neither). USE_MERGED_VCPKG_MANIFEST makes the build install the vcpkg dependencies of every extension.
# DuckDB takes its version string from git, and the build context has no .git.
RUN VCPKG_TOOLCHAIN_PATH=/opt/vcpkg/scripts/buildsystems/vcpkg.cmake \
    USE_MERGED_VCPKG_MANIFEST=1 \
    OVERRIDE_GIT_DESCRIBE=v1.5.4-0-g08e34c447 \
    GEN=ninja \
    make release \
        EXTRA_EXTENSION_CONFIGS=/src/extension_config_https.cmake \
        EXT_RELEASE_FLAGS="-DBUILD_UNITTESTS=OFF -DSTATIC_LIBCPP=TRUE -DDISABLE_EXTENSION_LOAD=1" \
    && strip build/release/duckdb

FROM gcr.io/distroless/base-debian12
COPY --from=build /src/build/release/duckdb /duckdb
ENV HOME=/tmp
WORKDIR /data
ENTRYPOINT ["/duckdb"]
